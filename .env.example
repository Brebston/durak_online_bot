# Токен бота від @BotFather
BOT_TOKEN=123456789:AA...
# Публічна HTTPS-адреса, де працює сервер (Mini App відкривається звідси)
WEBAPP_URL=https://durak.example.com
# Telegram ID адміністраторів через кому (свій ID можна дізнатися в @userinfobot)
ADMIN_IDS=123456789
# 1 Telegram Star = N фішок
STARS_TO_CHIPS=10
# Опційний орієнтовний EUR-курс для ручних заявок на виплату (0 = оцінку не показувати).
# Реальна ціна купівлі Stars залежить від платформи, способу оплати й регіону.
WITHDRAWAL_EUR_PER_STAR=0
STAR_PACKS=25,50,100,250
# Ставки для гри на фішки
STAKES=10,50,100,500
# Комісія з програної ставки, %
COMMISSION_PERCENT=0
# Безкоштовних ігор на день (0 = без обмежень; адмінів не стосується)
FREE_GAMES_PER_DAY=1
# Лише для локальної розробки без Telegram!
DEV_MODE=0
DATA_DIR=/data

# Через скільки секунд «Знайти гру» підсаджує ботів, якщо живих суперників немає
BOT_FILL_SECONDS=8
